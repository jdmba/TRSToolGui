<Project Sdk="Microsoft.NET.Sdk">
  <!-- TRSToolGui for Linux and macOS: the same Core library as the Windows program, with windows built on
       Eto.Forms (GTK 3 underneath on Linux, Cocoa on a Mac). Publish with:
         dotnet publish Eto\TRSToolGui.Eto.vbproj -c Release                 Linux x64, one file
         dotnet publish Eto\TRSToolGui.Eto.vbproj -c Release -r osx-arm64    Mac with Apple Silicon: TRSToolGui.app
         dotnet publish Eto\TRSToolGui.Eto.vbproj -c Release -r osx-x64      Mac with an Intel processor: TRSToolGui.app
       All three build on Windows. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TRSToolGui</RootNamespace>
    <AssemblyName>TRSToolGui</AssemblyName>
    <StartupObject>TRSToolGui.Program</StartupObject>
    <MyType>Empty</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Nullable>disable</Nullable>
    <Version>1.8.0</Version>
    <Product>TRSToolGui</Product>
    <Authors>Ira Goldklang and Claude AI</Authors>
    <Company>Ira Goldklang and Claude AI</Company>
    <Copyright>© 2026 Ira Goldklang and Claude AI</Copyright>
    <Description>GUI over Lawrence Kesteloot's trs80-tool, in the spirit of Matthew Reed's TRSTools (Eto.Forms build for Linux and macOS)</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Linux unless the command line names another system with -r. -->
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">linux-x64</RuntimeIdentifier>
    <TrsMac Condition="$(RuntimeIdentifier.StartsWith('osx'))">true</TrsMac>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- The GtkSharp package would otherwise download a GTK runtime for Windows onto a Windows build machine.
         The Linux build uses the GTK 3 that Linux has. -->
    <SkipGtkInstall>True</SkipGtkInstall>
  </PropertyGroup>
  <!-- MacOpenDocuments.vb talks to NSAppleEventManager through the MonoMac bindings that come with
       Eto.Platform.Mac64, so it is in the Mac build and no other, and TRSMAC is what lets Program.vb
       call it without naming it on a system where it does not exist. -->
  <PropertyGroup Condition="'$(TrsMac)' == 'true'">
    <DefineConstants Condition="'$(DefineConstants)' == ''">TRSMAC=True</DefineConstants>
    <DefineConstants Condition="'$(DefineConstants)' != ''">$(DefineConstants),TRSMAC=True</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(TrsMac)' != 'true'">
    <Compile Remove="MacOpenDocuments.vb" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Core\TRSToolGui.Core.vbproj" />
    <PackageReference Include="Eto.Forms" Version="2.11.0" />
  </ItemGroup>
  <!-- One window toolkit per system. -->
  <ItemGroup Condition="'$(TrsMac)' != 'true'">
    <PackageReference Include="Eto.Platform.Gtk" Version="2.11.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TrsMac)' == 'true'">
    <PackageReference Include="Eto.Platform.Mac64" Version="2.11.0" />
    <!-- The icon of TRSToolGui.app. -->
    <BundleResource Include="Icon.icns" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\Help\Manual.txt" LogicalName="TRSToolGui.Manual.txt" />
    <EmbeddedResource Include="..\Help\Changelog.txt" LogicalName="TRSToolGui.Changelog.txt" />
    <EmbeddedResource Include="..\Help\License.txt" LogicalName="TRSToolGui.License.txt" />
    <!-- The window icon. A Mac takes the application's icon from Icon.icns in the bundle instead,
         but the window asks for this one on every system and GTK is the one that shows it. -->
    <EmbeddedResource Include="Icon.png" LogicalName="TRSToolGui.Icon.png" />
  </ItemGroup>

  <!-- macOS: the Eto.Platform.Mac64 package wraps the published program in TRSToolGui.app. It is told the
       bundle's name here and is handed an Info.plist written from this project's own version number, so the
       version is kept in one place. -->
  <PropertyGroup Condition="'$(TrsMac)' == 'true'">
    <MacBundleName>TRSToolGui</MacBundleName>
    <TrsInfoPlist><![CDATA[<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleName</key>
	<string>TRSToolGui</string>
	<key>CFBundleDisplayName</key>
	<string>TRSToolGui</string>
	<key>CFBundleIdentifier</key>
	<string>com.trs-80.TRSToolGui</string>
	<key>CFBundleShortVersionString</key>
	<string>$(Version)</string>
	<key>CFBundleVersion</key>
	<string>$(Version)</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 Ira Goldklang</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleIconFile</key>
	<string>Icon.icns</string>
	<key>LSMinimumSystemVersion</key>
	<string>12.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>TRS-80 floppy disk image</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>dmk</string>
				<string>jv1</string>
				<string>jv3</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Owner</string>
		</dict>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Floppy disk image</string>
			<key>CFBundleTypeExtensions</key>
			<array>
				<string>dsk</string>
				<string>hfe</string>
				<string>imd</string>
				<string>scp</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
		</dict>
	</array>
</dict>
</plist>]]></TrsInfoPlist>
  </PropertyGroup>
  <Target Name="TrsWriteInfoPlist" BeforeTargets="MacInitializeBundle" Condition="'$(TrsMac)' == 'true'">
    <PropertyGroup>
      <InputPListFile>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'TRSToolGui.Info.plist'))</InputPListFile>
    </PropertyGroup>
    <WriteLinesToFile File="$(InputPListFile)" Lines="$(TrsInfoPlist)" Overwrite="true" />
  </Target>
</Project>
