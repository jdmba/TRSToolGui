<Project Sdk="Microsoft.NET.Sdk">
  <!-- Everything in TRSToolGui that is not a window: the trs80-tool adapter, the disk model, the DMK analysis,
       the assembler-source analysis, the settings and the platform differences. It targets plain net10.0 and
       references no window toolkit, so it builds and runs on Windows, Linux and macOS. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>TRSToolGui</RootNamespace>
    <AssemblyName>TRSToolGui.Core</AssemblyName>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <Nullable>disable</Nullable>
    <Version>1.8.0</Version>
    <Product>TRSToolGui</Product>
    <Authors>Ira Goldklang and Claude AI</Authors>
    <Company>Ira Goldklang and Claude AI</Company>
    <Copyright>© 2026 Ira Goldklang and Claude AI</Copyright>
    <Description>The engine adapter, disk model and analysis code of TRSToolGui, without any window toolkit</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- The program's user-visible text, one table per language, read by UiText.vb. The name a table is
         embedded under is worked out from its file name, so a new language needs no change here: put
         Lang\<code>.txt beside en.txt and list the code in UiText._declared. -->
    <EmbeddedResource Include="Lang\*.txt">
      <LogicalName>TRSToolGui.Lang.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
